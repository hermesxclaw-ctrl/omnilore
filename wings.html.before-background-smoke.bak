<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>The Wings — Omnilore</title><meta name="description" content="Seventeen wings of Omnilore, each a different door into the archive."><link rel="icon" href="assets/logo.svg" type="image/svg+xml"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,500&family=EB+Garamond:ital,wght@0,400;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap">
<style>
:root{--ink:#090a0d;--night:#121017;--plum:#211523;--bone:#eee6d3;--brass:#c6a95a;--signal:#8bbfc1;--ember:#b85f47;--hair:rgba(238,230,211,.15)}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 8% 9%,rgba(139,191,193,.13),transparent 25%),radial-gradient(circle at 94% 55%,rgba(184,95,71,.12),transparent 27%),var(--ink);color:var(--bone);font:18px/1.55 'EB Garamond',Georgia,serif}body:before{content:'';position:fixed;inset:0;pointer-events:none;z-index:10;opacity:.12;background:repeating-linear-gradient(0deg,transparent 0 3px,rgba(255,255,255,.025) 4px),radial-gradient(ellipse,transparent 43%,rgba(0,0,0,.62));mix-blend-mode:soft-light}.nav{height:70px;position:sticky;top:0;z-index:9;display:flex;align-items:center;gap:13px;padding:0 clamp(16px,4vw,56px);background:rgba(9,10,13,.92);border-bottom:1px solid var(--hair);backdrop-filter:blur(18px)}.nav img{width:31px;filter:drop-shadow(0 0 9px rgba(198,169,90,.6))}.logo{font:500 .53rem 'JetBrains Mono',monospace;letter-spacing:3px;color:rgba(238,230,211,.56);text-decoration:none}.logo strong{display:block;font:700 1.32rem 'Cormorant Garamond',serif;letter-spacing:.5px;color:#f0d997}.nav-links{margin-left:auto;display:flex;gap:15px}.nav-links a{font:500 .56rem 'JetBrains Mono',monospace;letter-spacing:1.6px;color:rgba(238,230,211,.6);text-decoration:none;text-transform:uppercase;padding:12px 2px}.nav-links a.active,.nav-links a:hover{color:var(--signal)}.masthead{position:relative;overflow:hidden;min-height:430px;padding:110px max(24px,8vw) 82px;border-bottom:1px solid var(--hair);background:linear-gradient(105deg,rgba(9,10,13,.85),rgba(9,10,13,.15)),radial-gradient(ellipse at 72% 42%,rgba(198,169,90,.18),transparent 40%)}.masthead:before{content:'XVII';position:absolute;right:6vw;top:15px;font:italic clamp(13rem,28vw,28rem)/.8 'Cormorant Garamond',serif;color:rgba(238,230,211,.035)}.masthead:after{content:'THE WINGS ARE NOT CATEGORIES · THEY ARE DOORS';position:absolute;right:34px;top:50%;writing-mode:vertical-rl;font:500 .51rem 'JetBrains Mono',monospace;letter-spacing:4px;color:var(--signal)}.eyebrow{position:relative;color:var(--signal);font:500 .58rem 'JetBrains Mono',monospace;letter-spacing:4px;text-transform:uppercase}.masthead h1{position:relative;max-width:850px;margin:15px 0 20px;font:700 clamp(4rem,9vw,9rem)/.78 'Cormorant Garamond',serif;letter-spacing:-3px}.masthead h1 em{color:#f0d997}.masthead p{position:relative;max-width:520px;color:rgba(238,230,211,.72)}.wing-count{position:absolute;right:10vw;bottom:54px;color:var(--brass);font:500 .6rem 'JetBrains Mono',monospace;letter-spacing:2px}.wing-count b{display:block;font:700 4rem/.8 'Cormorant Garamond',serif;color:#f0d997}.gallery{max-width:1400px;margin:0 auto;padding:92px clamp(18px,5vw,72px) 130px;display:grid;grid-template-columns:repeat(12,1fr);grid-auto-flow:dense;gap:18px}.wing-door{--edge:var(--brass);--wash:rgba(198,169,90,.16);position:relative;isolation:isolate;overflow:hidden;min-height:250px;padding:28px;text-decoration:none;color:var(--bone);border:1px solid color-mix(in srgb,var(--edge) 54%,transparent);background:linear-gradient(145deg,var(--wash),rgba(9,10,13,.6) 54%),var(--night);box-shadow:10px 14px 0 rgba(0,0,0,.24);transition:transform .25s ease,filter .25s ease,box-shadow .25s ease}.wing-door:before{content:'';position:absolute;inset:9px;z-index:-1;border:1px solid color-mix(in srgb,var(--edge) 35%,transparent);background:radial-gradient(circle at 90% 12%,var(--wash),transparent 37%)}.wing-door:after{content:'';position:absolute;left:0;right:0;top:0;height:3px;background:var(--edge);box-shadow:0 0 15px var(--edge)}.wing-door:hover{transform:translateY(-9px) rotate(-.3deg);filter:brightness(1.14);box-shadow:18px 27px 0 rgba(0,0,0,.27),0 0 45px var(--wash)}.wing-door:focus-visible{outline:2px solid #f0d997;outline-offset:5px}.wing-door .arch-glyph{display:block;color:var(--edge);font-size:2.2rem;margin-bottom:28px}.wing-door b{display:block;max-width:240px;font:700 clamp(1.55rem,2.3vw,2.45rem)/.9 'Cormorant Garamond',serif;letter-spacing:-.7px}.wing-door .arch-count{display:block;margin-top:13px;color:var(--signal);font:500 .55rem 'JetBrains Mono',monospace;letter-spacing:1.5px;text-transform:uppercase}.wing-door p{margin:17px 0 0;color:rgba(238,230,211,.52);font:500 .5rem 'JetBrains Mono',monospace;letter-spacing:1.8px;text-transform:uppercase}.wing-1{grid-column:span 7;min-height:355px;clip-path:polygon(0 7%,5% 0,100% 0,100% 92%,95% 100%,0 100%)}.wing-2{grid-column:span 5;clip-path:polygon(0 0,93% 0,100% 8%,100% 100%,8% 100%,0 92%);--edge:#c94242;--wash:rgba(201,55,55,.18)}.wing-3{grid-column:span 4;clip-path:polygon(0 0,100% 0,94% 48%,100% 100%,0 100%,7% 51%);--edge:#9471c9;--wash:rgba(116,77,188,.2)}.wing-4{grid-column:span 8;min-height:320px;clip-path:polygon(0 0,100% 0,100% 84%,92% 100%,12% 100%,0 87%);--edge:#d06b42;--wash:rgba(184,95,71,.18)}.wing-5{grid-column:span 5;clip-path:polygon(0 9%,9% 0,91% 0,100% 9%,100% 91%,91% 100%,9% 100%,0 91%);--edge:#82b85f;--wash:rgba(101,159,77,.2)}.wing-6{grid-column:span 3;min-height:300px;clip-path:polygon(0 0,100% 8%,100% 100%,0 92%);--edge:#74bdb6;--wash:rgba(79,174,165,.17)}.wing-7{grid-column:span 4;clip-path:polygon(8% 0,100% 0,92% 100%,0 100%);--edge:#48a5e0;--wash:rgba(42,138,219,.2)}.wing-8{grid-column:span 5;clip-path:polygon(0 0,100% 0,100% 100%,11% 100%,0 88%);--edge:#e28a43;--wash:rgba(204,100,35,.18)}.wing-9{grid-column:span 6;min-height:330px;clip-path:polygon(0 0,100% 0,100% 100%,0 91%);--edge:#5caeb4;--wash:rgba(61,152,161,.18)}.wing-10{grid-column:span 6;clip-path:polygon(0 0,100% 0,100% 83%,91% 100%,0 100%);--edge:#b47bd0;--wash:rgba(140,73,178,.18)}.wing-11{grid-column:span 4;clip-path:polygon(0 0,100% 0,92% 52%,100% 100%,0 100%,8% 51%);--edge:#d69d30;--wash:rgba(193,129,14,.18)}.wing-12{grid-column:span 5;min-height:290px;clip-path:polygon(0 0,91% 0,100% 14%,100% 100%,0 100%);--edge:#dc9e32;--wash:rgba(208,142,19,.18)}.wing-13{grid-column:span 3;clip-path:polygon(0 13%,100% 0,100% 87%,0 100%);--edge:#b8c94e;--wash:rgba(164,181,42,.18)}.wing-14{grid-column:span 7;min-height:320px;clip-path:polygon(0 0,100% 0,100% 100%,5% 100%,0 92%);--edge:#d6b244;--wash:rgba(185,149,32,.18)}.wing-15{grid-column:span 5;clip-path:polygon(0 0,100% 8%,100% 100%,0 92%);--edge:#8fbeea;--wash:rgba(78,142,207,.18)}.wing-16{grid-column:span 4;clip-path:polygon(0 0,100% 0,100% 100%,9% 100%,0 84%);--edge:#d39a2e;--wash:rgba(191,126,19,.18)}.wing-17{grid-column:span 8;min-height:300px;clip-path:polygon(0 0,95% 0,100% 13%,100% 100%,0 100%);--edge:#e3c55d;--wash:rgba(209,177,57,.18)}footer{padding:55px 20px;text-align:center;border-top:1px solid var(--hair);font:500 .52rem 'JetBrains Mono',monospace;letter-spacing:2px;color:rgba(238,230,211,.4)}@media(max-width:850px){.gallery{grid-template-columns:repeat(2,1fr);gap:12px}.wing-door{grid-column:span 1!important;min-height:230px!important}.masthead{padding-block:84px}.wing-count{right:7vw}.masthead:after{display:none}}@media(max-width:500px){.nav{height:59px}.nav-links{gap:10px}.nav-links a{font-size:.48rem}.logo{display:none}.masthead{min-height:370px;padding:76px 23px}.masthead h1{font-size:clamp(4rem,20vw,5.5rem)}.wing-count{bottom:35px}.gallery{padding:55px 13px 82px;grid-template-columns:1fr}.wing-door{min-height:225px!important;padding:22px}.wing-door b{font-size:2rem}.wing-door:hover{transform:translateY(-4px)} }@media(prefers-reduced-motion:reduce){.wing-door{transition:none}.wing-door:hover{transform:none}}

/* Glassy broken wings pass */
.gallery{background:radial-gradient(circle at 18% 15%,rgba(139,191,193,.11),transparent 28%),radial-gradient(circle at 86% 52%,rgba(184,95,71,.10),transparent 31%)}
.wing-door{background:linear-gradient(135deg,rgba(255,255,255,.105),transparent 24%,rgba(9,10,13,.48) 57%),linear-gradient(145deg,var(--wash),rgba(10,13,18,.6) 55%),rgba(18,16,23,.62);backdrop-filter:blur(15px) saturate(1.18);-webkit-backdrop-filter:blur(15px) saturate(1.18);box-shadow:inset 1px 1px 0 rgba(255,255,255,.28),inset -1px -1px 0 rgba(0,0,0,.42),10px 14px 0 rgba(0,0,0,.22),0 18px 34px rgba(0,0,0,.2)}
.wing-door::before{background:linear-gradient(125deg,rgba(255,255,255,.14),transparent 18% 68%,rgba(255,255,255,.035)),radial-gradient(circle at 89% 11%,var(--wash),transparent 43%)!important;border-color:color-mix(in srgb,var(--edge) 52%,rgba(255,255,255,.2))}.wing-door::after{box-shadow:0 0 18px var(--edge),0 1px 0 rgba(255,255,255,.35)}
.wing-door:hover{background:linear-gradient(135deg,rgba(255,255,255,.16),transparent 27%,rgba(9,10,13,.38) 59%),linear-gradient(145deg,var(--wash),rgba(15,18,25,.5) 58%),rgba(18,16,23,.72);box-shadow:inset 1px 1px 0 rgba(255,255,255,.36),inset -1px -1px 0 rgba(0,0,0,.4),18px 27px 0 rgba(0,0,0,.25),0 0 46px var(--wash)}
.wing-door .arch-glyph{filter:drop-shadow(0 0 8px var(--edge))}.wing-door b{text-shadow:0 2px 16px rgba(0,0,0,.65)}


/* Obsidian pass — keep the glass, extinguish the room. */
body{background:#030405!important;background-image:radial-gradient(circle at 9% 10%,rgba(83,121,122,.045),transparent 24%),radial-gradient(circle at 93% 56%,rgba(110,48,39,.04),transparent 26%)!important}
.gallery{background:linear-gradient(90deg,rgba(39,69,70,.07),transparent 19%,transparent 81%,rgba(84,39,35,.06))!important}
.wing-door{background:linear-gradient(135deg,rgba(255,255,255,.042),transparent 20%,rgba(0,0,0,.76) 57%),linear-gradient(145deg,color-mix(in srgb,var(--wash) 38%,transparent),rgba(3,4,5,.92) 58%),#050607!important;box-shadow:inset 1px 1px 0 rgba(255,255,255,.11),inset -1px -1px 0 rgba(0,0,0,.75),10px 14px 0 rgba(0,0,0,.42),0 14px 30px rgba(0,0,0,.44)!important}
.wing-door::before{background:linear-gradient(125deg,rgba(255,255,255,.055),transparent 17% 70%,rgba(255,255,255,.015)),radial-gradient(circle at 89% 11%,color-mix(in srgb,var(--wash) 48%,transparent),transparent 43%)!important;border-color:color-mix(in srgb,var(--edge) 36%,rgba(255,255,255,.08))!important}.wing-door::after{box-shadow:0 0 9px color-mix(in srgb,var(--edge) 58%,transparent)!important}.wing-door:hover{background:linear-gradient(135deg,rgba(255,255,255,.075),transparent 22%,rgba(0,0,0,.69) 59%),linear-gradient(145deg,color-mix(in srgb,var(--wash) 55%,transparent),rgba(3,4,5,.88) 58%),#050607!important;box-shadow:inset 1px 1px 0 rgba(255,255,255,.16),inset -1px -1px 0 rgba(0,0,0,.7),18px 27px 0 rgba(0,0,0,.4),0 0 25px color-mix(in srgb,var(--wash) 58%,transparent)!important}
.masthead{background:linear-gradient(105deg,rgba(3,4,5,.96),rgba(3,4,5,.56)),radial-gradient(ellipse at 72% 42%,rgba(198,169,90,.07),transparent 40%)!important}.nav{background:rgba(3,4,5,.96)!important}


/* Atmospheric interiors — each door contains its own suspended weather. */
.wing-door{isolation:isolate;background:linear-gradient(145deg,rgba(255,255,255,.055),transparent 18%,rgba(0,0,0,.58) 61%),radial-gradient(ellipse at 72% 120%,color-mix(in srgb,var(--edge) 20%,transparent),transparent 55%),rgba(5,7,10,.63)!important}
.wing-door>*:not(.wing-atmosphere){position:relative;z-index:3}.wing-atmosphere{position:absolute;z-index:1;inset:1px;pointer-events:none;overflow:hidden;opacity:.92;background:radial-gradient(ellipse at 17% 118%,color-mix(in srgb,var(--edge) 29%,transparent),transparent 42%),radial-gradient(ellipse at 84% 12%,rgba(255,255,255,.09),transparent 29%),linear-gradient(120deg,transparent 0 31%,rgba(255,255,255,.055) 31.15% 31.35%,transparent 31.55% 54%,rgba(255,255,255,.035) 54.2% 54.35%,transparent 54.55%)}
.wing-atmosphere:before{content:'';position:absolute;inset:-22%;opacity:.58;background:radial-gradient(ellipse at 30% 70%,rgba(220,232,235,.12),transparent 18%),radial-gradient(ellipse at 64% 45%,color-mix(in srgb,var(--edge) 23%,transparent),transparent 24%),radial-gradient(ellipse at 87% 88%,rgba(220,232,235,.08),transparent 19%);filter:blur(16px);transform:rotate(-8deg)}
.wing-atmosphere:after{content:'';position:absolute;inset:14px;opacity:.55;background:linear-gradient(112deg,transparent 0 19%,rgba(255,255,255,.14) 19.1% 19.35%,transparent 19.55% 52%,rgba(255,255,255,.1) 52.1% 52.28%,transparent 52.46% 76%,rgba(255,255,255,.07) 76.1% 76.22%,transparent 76.4%),linear-gradient(24deg,transparent 0 38%,color-mix(in srgb,var(--edge) 55%,transparent) 38.1% 38.35%,transparent 38.55% 69%,rgba(255,255,255,.08) 69.1% 69.28%,transparent 69.5%);clip-path:polygon(0 8%,96% 0,100% 84%,73% 100%,0 91%)}
.wing-2 .wing-atmosphere{transform:scaleX(-1)}.wing-3 .wing-atmosphere{transform:rotate(6deg) scale(1.08)}.wing-4 .wing-atmosphere{transform:rotate(-4deg) scale(1.08)}.wing-5 .wing-atmosphere:before{filter:blur(20px);opacity:.75}.wing-6 .wing-atmosphere{transform:rotate(8deg)}.wing-7 .wing-atmosphere:after{clip-path:polygon(0 0,100% 14%,91% 100%,0 84%)}.wing-8 .wing-atmosphere{transform:scaleX(-1) rotate(3deg)}.wing-9 .wing-atmosphere:before{transform:rotate(15deg) scale(1.3)}.wing-10 .wing-atmosphere{transform:rotate(-7deg)}.wing-11 .wing-atmosphere:after{clip-path:polygon(7% 0,100% 0,91% 52%,100% 100%,0 100%,10% 52%)}.wing-12 .wing-atmosphere{transform:scaleX(-1)}.wing-13 .wing-atmosphere:before{opacity:.8;filter:blur(22px)}.wing-14 .wing-atmosphere{transform:rotate(4deg) scale(1.05)}.wing-15 .wing-atmosphere:after{clip-path:polygon(0 0,100% 10%,95% 100%,0 89%)}.wing-16 .wing-atmosphere{transform:rotate(-5deg)}.wing-17 .wing-atmosphere:before{transform:scale(1.22);opacity:.75}
.wing-door b{margin-top:6px}.wing-door .arch-count{color:color-mix(in srgb,var(--edge) 62%,#b8e1e0)}.wing-door p{color:rgba(238,230,211,.59)}
@media(prefers-reduced-motion:no-preference){.wing-door:hover .wing-atmosphere:before{transform:translate(8px,-5px) rotate(-5deg);transition:transform .55s ease}.wing-door:hover .wing-atmosphere:after{opacity:.8;transition:opacity .35s ease}}

</style></head><body><nav class="nav"><img src="assets/logo.svg" alt="Omnilore seal"><a href="index.html" class="logo"><strong>Omnilore</strong>THE ARCHIVE OF ALL THINGS UNREAL</a><div class="nav-links"><a href="browse.html">Browse</a><a href="rabbit-hole.html">Rabbit Hole</a><a href="index.html" id="rand">Random</a><a class="active" href="wings.html">Wings</a></div></nav><header class="masthead"><div class="eyebrow">The architectural index</div><h1>Choose a <em>door,</em><br>not a filter.</h1><p>Every wing has its own weather, its own rules, and its own way of teaching you what the Archive contains. Find the room that is looking for you.</p><div class="wing-count"><b>17</b>active thresholds</div></header><main class="gallery"><a class="wing-door wing-1" href="browse.html#divine" style="--ac:#e8a33d;--acg:rgba(232,163,61,0.16)"><span class="wing-atmosphere" aria-hidden="true"></span><span class="arch-glyph">✦</span><b>The Pantheon Halls</b><span class="arch-count">624 entities</span><p>divine collection</p></a>
<a class="wing-door wing-2" href="browse.html#demonic" style="--ac:#c8322b;--acg:rgba(200,50,43,0.16)"><span class="wing-atmosphere" aria-hidden="true"></span><span class="arch-glyph">⛧</span><b>The Locked Wing</b><span class="arch-count">141 entities</span><p>infernal register</p></a>
<a class="wing-door wing-3" href="browse.html#eldritch" style="--ac:#7b5cbf;--acg:rgba(123,92,191,0.18)"><span class="wing-atmosphere" aria-hidden="true"></span><span class="arch-glyph">⁙</span><b>The Sealed Vault</b><span class="arch-count">16 entities</span><p>restricted archive</p></a>
<a class="wing-door wing-4" href="browse.html#yokai" style="--ac:#d4502e;--acg:rgba(212,80,46,0.16)"><span class="wing-atmosphere" aria-hidden="true"></span><span class="arch-glyph">⍟</span><b>The Night Parade</b><span class="arch-count">37 entities</span><p>yokai scrolls</p></a>
<a class="wing-door wing-5" href="browse.html#cryptid" style="--ac:#7da44c;--acg:rgba(125,164,76,0.15)"><span class="wing-atmosphere" aria-hidden="true"></span><span class="arch-glyph">◉</span><b>The Evidence Room</b><span class="arch-count">60 entities</span><p>field investigation</p></a>
<a class="wing-door wing-6" href="browse.html#fae" style="--ac:#7fb8a4;--acg:rgba(127,184,164,0.16)"><span class="wing-atmosphere" aria-hidden="true"></span><span class="arch-glyph">❀</span><b>The Twilight Garden</b><span class="arch-count">43 entities</span><p>the courts unseen</p></a>
<a class="wing-door wing-7" href="browse.html#internet-horror" style="--ac:#3f8cc7;--acg:rgba(63,140,199,0.16)"><span class="wing-atmosphere" aria-hidden="true"></span><span class="arch-glyph">█</span><b>The Server Vault</b><span class="arch-count">222 entities</span><p>digital containment</p></a>
<a class="wing-door wing-8" href="browse.html#analog-horror" style="--ac:#c4632f;--acg:rgba(196,99,47,0.18)"><span class="wing-atmosphere" aria-hidden="true"></span><span class="arch-glyph">●</span><b>The Tape Library</b><span class="arch-count">17 entities</span><p>field archive</p></a>
<a class="wing-door wing-9" href="browse.html#spirit" style="--ac:#6fa8b8;--acg:rgba(111,168,184,0.16)"><span class="wing-atmosphere" aria-hidden="true"></span><span class="arch-glyph">۩</span><b>The Veiled Gallery</b><span class="arch-count">164 entities</span><p>spirit register</p></a>
<a class="wing-door wing-10" href="browse.html#undead" style="--ac:#9b7bb8;--acg:rgba(155,123,184,0.15)"><span class="wing-atmosphere" aria-hidden="true"></span><span class="arch-glyph">†</span><b>The Cold Crypt</b><span class="arch-count">34 entities</span><p>mortuary archive</p></a>
<a class="wing-door wing-11" href="browse.html#trickster" style="--ac:#d99a2b;--acg:rgba(217,154,43,0.16)"><span class="wing-atmosphere" aria-hidden="true"></span><span class="arch-glyph">☵</span><b>The Crooked Hall</b><span class="arch-count">34 entities</span><p>mischief ledger</p></a>
<a class="wing-door wing-12" href="browse.html#heroic-legend" style="--ac:#c98f3d;--acg:rgba(201,143,61,0.16)"><span class="wing-atmosphere" aria-hidden="true"></span><span class="arch-glyph">⚔</span><b>The Bronze Gallery</b><span class="arch-count">54 entities</span><p>hall of heroes</p></a>
<a class="wing-door wing-13" href="browse.html#beast" style="--ac:#b8923d;--acg:rgba(184,146,61,0.15)"><span class="wing-atmosphere" aria-hidden="true"></span><span class="arch-glyph">☘</span><b>The Great Menagerie</b><span class="arch-count">434 entities</span><p>bestiary</p></a>
<a class="wing-door wing-14" href="browse.html#cosmic" style="--ac:#5f7fd9;--acg:rgba(95,127,217,0.16)"><span class="wing-atmosphere" aria-hidden="true"></span><span class="arch-glyph">✦</span><b>The Observatory</b><span class="arch-count">34 entities</span><p>celestial survey</p></a>
<a class="wing-door wing-15" href="browse.html#construct" style="--ac:#b0873f;--acg:rgba(176,135,63,0.16)"><span class="wing-atmosphere" aria-hidden="true"></span><span class="arch-glyph">⚙</span><b>The Workshop Vault</b><span class="arch-count">8 entities</span><p>artifice registry</p></a>
<a class="wing-door wing-16" href="browse.html#relic" style="--ac:#c9a227;--acg:rgba(201,162,39,0.16)"><span class="wing-atmosphere" aria-hidden="true"></span><span class="arch-glyph">⚱</span><b>The Reliquary</b><span class="arch-count">10 entities</span><p>reliquary</p></a>
<a class="wing-door wing-17" href="browse.html#fine-art" style="--ac:#c4a35a;--acg:rgba(196,163,90,0.15)"><span class="wing-atmosphere" aria-hidden="true"></span><span class="arch-glyph">▣</span><b>The Painted Wing</b><span class="arch-count">78 entities</span><p>gallery of the unreal</p></a></main><footer>OMNILORE — THE ARCHIVE OF ALL THINGS UNREAL<br>every door opens somewhere stranger</footer></body></html>