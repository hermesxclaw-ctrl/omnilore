<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Browse the Archive — Omnilore</title>
<meta name="description" content="Browse all 2,000 entities of the Omnilore Archive by collection, culture, and name.">
<meta name="theme-color" content="#141210">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,500&family=EB+Garamond:ital,wght@0,400;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap">
<style>
:root{--bg:#141210;--s:#1f1d19;--s2:#25231f;--t:#e8e4dc;--t2:#a09c94;--t3:#6b6760;--p:#c9a84c;--pl:#e0c878;--pg:rgba(201,168,76,0.12);--b:#2d2a25;--b2:#3d3a35}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
body{font-family:'EB Garamond',Georgia,serif;font-size:17px;line-height:1.7;color:var(--t);background:var(--bg)}
a{color:var(--p);text-decoration:none}
.nav{position:sticky;top:0;z-index:100;display:flex;align-items:center;gap:18px;padding:0 24px;height:56px;background:rgba(20,18,16,0.95);backdrop-filter:blur(12px);border-bottom:1px solid var(--b)}
.logo{font-family:'JetBrains Mono',monospace;font-size:0.6rem;letter-spacing:2px;color:var(--t2);text-transform:uppercase;line-height:1.25}
.logo strong{display:block;font-family:'Cormorant Garamond',serif;font-size:1.05rem;color:var(--p);font-weight:700;text-transform:none}
.wrap{max-width:1200px;margin:0 auto;padding:40px 24px}
h1{font-family:'Cormorant Garamond',serif;font-size:2.4rem;font-weight:600;margin-bottom:6px}
.count{font-family:'JetBrains Mono',monospace;font-size:0.66rem;color:var(--t3);letter-spacing:1.5px;text-transform:uppercase;margin-bottom:24px}
#bq{width:100%;max-width:460px;background:var(--s);border:1px solid var(--b);color:var(--t);padding:11px 18px;border-radius:24px;font-size:0.95rem;outline:none;font-family:'EB Garamond',serif;margin-bottom:18px}
#bq:focus{border-color:var(--p)}
.f-row{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:30px}
.f-btn{font-family:'JetBrains Mono',monospace;font-size:0.6rem;letter-spacing:1px;text-transform:uppercase;color:var(--t2);border:1px solid var(--b2);background:var(--s);padding:7px 13px;cursor:pointer;transition:all 0.2s}
.f-btn:hover{border-color:var(--p);color:var(--pl)}
.f-btn.on{border-color:var(--p);background:var(--pg);color:var(--pl)}
.c-btn{font-family:'EB Garamond',serif;font-size:0.78rem;color:var(--t2);border:1px solid var(--b2);background:var(--s);padding:6px 12px;cursor:pointer;transition:all 0.2s}
.c-btn em{font-style:normal;font-family:'JetBrains Mono',monospace;font-size:0.55rem;color:var(--t3);margin-left:4px}
.c-btn:hover{border-color:var(--p);color:var(--pl)}
.c-btn.on{border-color:var(--p);background:var(--pg);color:var(--pl)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px}
.card{border:1px solid var(--b2);background:linear-gradient(160deg,var(--s),transparent);padding:18px;display:block;transition:all 0.22s}
.card:hover{border-color:var(--p);transform:translateY(-3px)}
.card small{font-family:'JetBrains Mono',monospace;font-size:0.55rem;color:var(--p);letter-spacing:1.2px;text-transform:uppercase;display:block;margin-bottom:6px}
.card b{font-family:'Cormorant Garamond',serif;font-size:1.2rem;color:var(--t);font-weight:600;display:block;line-height:1.2}
.card i{font-size:0.83rem;color:var(--t2);display:block;margin-top:5px;line-height:1.45}
.more{display:block;margin:34px auto 10px;padding:13px 32px;background:none;border:1px solid var(--p);color:var(--p);font-family:'JetBrains Mono',monospace;font-size:0.66rem;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer}
.more:hover{background:var(--pg)}
footer{border-top:1px solid var(--b);margin-top:60px;padding:36px 24px 60px;text-align:center;font-family:'JetBrains Mono',monospace;font-size:0.62rem;color:var(--t3);letter-spacing:1.5px}

/* Content advisory: a clear choice before entering the archive. */
#content-advisory[hidden]{display:none}#content-advisory{position:fixed;inset:0;z-index:1000;display:grid;place-items:center;padding:22px;background:rgba(1,2,3,.82);backdrop-filter:blur(14px)}.advisory-panel{width:min(650px,100%);position:relative;overflow:hidden;padding:clamp(28px,5vw,58px);background:linear-gradient(135deg,rgba(18,23,26,.94),rgba(5,7,9,.98));border:1px solid rgba(139,191,193,.34);box-shadow:0 28px 100px rgba(0,0,0,.65),inset 0 0 0 1px rgba(198,169,90,.1)}.advisory-panel:before{content:'CONTENT ADVISORY';position:absolute;right:-15px;top:24px;color:rgba(139,191,193,.08);font:700 clamp(3rem,11vw,7rem)/.8 'Cormorant Garamond',serif;letter-spacing:-3px}.advisory-kicker{position:relative;margin:0 0 13px;color:#8bbfc1;font:500 .58rem 'JetBrains Mono',monospace;letter-spacing:3px;text-transform:uppercase}.advisory-panel h1{position:relative;margin:0 0 14px;color:#eee6d3;font:700 clamp(2.8rem,8vw,5rem)/.85 'Cormorant Garamond',serif;letter-spacing:-1.5px}.advisory-panel p{position:relative;max-width:54ch;margin:0 0 16px;color:rgba(238,230,211,.76);font:1.08rem/1.48 'EB Garamond',Georgia,serif}.advisory-panel ul{position:relative;margin:16px 0 25px;padding-left:20px;color:rgba(238,230,211,.65);font:500 .63rem/1.9 'JetBrains Mono',monospace;letter-spacing:.4px}.advisory-actions{position:relative;display:flex;gap:12px;align-items:center;flex-wrap:wrap}.advisory-enter,.advisory-leave{display:inline-flex;align-items:center;min-height:44px;padding:12px 18px;border:0;cursor:pointer;font:600 .61rem 'JetBrains Mono',monospace;letter-spacing:1.4px;text-transform:uppercase}.advisory-enter{background:#e0c878;color:#050607}.advisory-leave{color:#d9e5e1;background:transparent;border:1px solid rgba(238,230,211,.28)}.advisory-legal{position:relative;display:block;margin-top:20px;color:#8bbfc1;font:500 .54rem 'JetBrains Mono',monospace;letter-spacing:1px;text-decoration:none}@media(max-width:500px){.advisory-panel{padding:30px 24px}.advisory-panel p{font-size:1rem}}

</style>
</head>
<body>
<nav class="nav"><a href="javascript:history.back()" style="color:var(--t2);font-family:'JetBrains Mono',monospace;font-size:0.64rem;letter-spacing:1.5px;text-transform:uppercase;white-space:nowrap">&larr; Back</a><a href="index.html" class="logo"><strong>The Archive</strong>OF ALL THINGS UNREAL</a></nav>
<div class="wrap">
<h1>Interrogate the collection</h1>
<p class="count" id="count">Loading the vaults…</p>
<input type="search" id="bq" placeholder="Filter by name, alias, culture…">
<div class="f-row" id="filters"><button class="f-btn on" data-k="all">All Wings</button><button class="f-btn" data-k="divine">✦ divine</button><button class="f-btn" data-k="demonic">⛧ demonic</button><button class="f-btn" data-k="eldritch">⁙ eldritch</button><button class="f-btn" data-k="yokai">⍟ yokai</button><button class="f-btn" data-k="cryptid">◉ cryptid</button><button class="f-btn" data-k="fae">❀ fae</button><button class="f-btn" data-k="internet-horror">█ internet horror</button><button class="f-btn" data-k="analog-horror">● analog horror</button><button class="f-btn" data-k="spirit">۩ spirit</button><button class="f-btn" data-k="undead">† undead</button><button class="f-btn" data-k="trickster">☵ trickster</button><button class="f-btn" data-k="heroic-legend">⚔ heroic legend</button><button class="f-btn" data-k="beast">☘ beast</button><button class="f-btn" data-k="cosmic">✦ cosmic</button><button class="f-btn" data-k="construct">⚙ construct</button><button class="f-btn" data-k="relic">⚱ relic</button><button class="f-btn" data-k="fine-art">▣ fine art</button></div>
<p class="count" style="margin-bottom:8px">PANTHEONS &amp; TRADITIONS</p>
<div class="f-row" id="cultures"><button class="c-btn on" data-c="all">All Cultures</button><button class="c-btn" data-c="SCP Foundation">SCP Foundation <em>139</em></button><button class="c-btn" data-c="Greek">Greek <em>68</em></button><button class="c-btn" data-c="Fine Art">Fine Art <em>65</em></button><button class="c-btn" data-c="Norse">Norse <em>56</em></button><button class="c-btn" data-c="Japanese">Japanese <em>49</em></button><button class="c-btn" data-c="Slavic">Slavic <em>44</em></button><button class="c-btn" data-c="Creepypasta">Creepypasta <em>36</em></button><button class="c-btn" data-c="Roman">Roman <em>30</em></button><button class="c-btn" data-c="Irish">Irish <em>30</em></button><button class="c-btn" data-c="Egyptian">Egyptian <em>28</em></button><button class="c-btn" data-c="Cthulhu Mythos (H.P. Lovecraft)">Cthulhu Mythos (H.P. Lovecraft) <em>28</em></button><button class="c-btn" data-c="Hindu">Hindu <em>27</em></button><button class="c-btn" data-c="Chinese">Chinese <em>25</em></button><button class="c-btn" data-c="The Backrooms">The Backrooms <em>25</em></button><button class="c-btn" data-c="Ars Goetia / Solomonic Demonology">Ars Goetia / Solomonic Demonology <em>25</em></button><button class="c-btn" data-c="Filipino">Filipino <em>24</em></button><button class="c-btn" data-c="Arthurian">Arthurian <em>22</em></button><button class="c-btn" data-c="Finnish (Kalevala)">Finnish (Kalevala) <em>21</em></button><button class="c-btn" data-c="Māori">Māori <em>20</em></button><button class="c-btn" data-c="Marvel Comics (Marvel Entertainment / Disney)">Marvel Comics (Marvel Entertainment / Disney) <em>20</em></button><button class="c-btn" data-c="DC Comics (Warner Bros. Discovery)">DC Comics (Warner Bros. Discovery) <em>20</em></button><button class="c-btn" data-c="Dungeons & Dragons (Wizards of the Coast / Hasbro)">Dungeons & Dragons (Wizards of the Coast / Hasbro) <em>18</em></button><button class="c-btn" data-c="Buddhist">Buddhist <em>16</em></button><button class="c-btn" data-c="Persian (Zoroastrian)">Persian (Zoroastrian) <em>16</em></button></div>
<div class="grid" id="grid"></div>
<button class="more" id="more" style="display:none">Unseal More ↓</button>
</div>
<footer>OMNILORE — never finished, always evolving<div class="legal-links"><a href="legal.html#content-advisory">Content advisory</a><a href="legal.html#terms">Terms of use</a><a href="legal.html#privacy">Privacy</a><a href="legal.html#copyright">Copyright</a><a href="legal.html#accessibility">Accessibility</a></div></footer>
<script src="assets/search-index.js"></script>
<script>
(function(){
var IDX=[],VIEW=[],shown=0,PAGE=60,arch='all',cult='all',q='';
function skel(s){return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/[^a-z]/g,'').replace(/[aeiou]/g,'').split('').filter(function(ch,i,a){return ch!==a[i-1]}).join('');}
function scpNum(n){var m=/SCP-(d+)/i.exec(n);return m?parseInt(m[1],10):999999;}
function card(e){return '<a class="card" href="entity/'+e.s+'.html"><small>'+(e.d?e.d+' · ':'')+(e.c||e.k)+'</small><b>'+e.n+'</b>'+(e.e?'<i>'+e.e+'</i>':'')+'</a>';}
function apply(){
  var v=q.toLowerCase();
  var vs=skel(v);
  VIEW=IDX.filter(function(e){
    if(arch!=='all'&&e.k!==arch)return false;
    if(cult!=='all'&&e.c!==cult)return false;
    if(!v)return true;
    if(e.n.toLowerCase().indexOf(v)>=0)return true;
    if((e.c||'').toLowerCase().indexOf(v)>=0)return true;
    for(var i=0;i<e.a.length;i++)if(e.a[i].toLowerCase().indexOf(v)>=0)return true;
    if(vs.length>2&&skel(e.n).indexOf(vs)>=0)return true;
    return false;});
  if(cult==='SCP Foundation')VIEW.sort(function(a,b){var d=scpNum(a.n)-scpNum(b.n);return d!==0?d:(a.n<b.n?-1:1);});
  shown=0;document.getElementById('grid').innerHTML='';
  document.getElementById('count').textContent=VIEW.length+' entities found';
  more();}
function more(){
  var g=document.getElementById('grid'),end=Math.min(shown+PAGE,VIEW.length),h='';
  for(;shown<end;shown++)h+=card(VIEW[shown]);
  g.insertAdjacentHTML('beforeend',h);
  document.getElementById('more').style.display=shown<VIEW.length?'block':'none';}
function boot(j){IDX=j.sort(function(a,b){return a.n.localeCompare(b.n)});var h=decodeURIComponent(location.hash.replace('#',''));
  if(h.indexOf('c=')===0){cult=h.substring(2);var cb2=document.querySelectorAll('.c-btn');for(var ci=0;ci<cb2.length;ci++){cb2[ci].classList.toggle('on',cb2[ci].dataset.c===cult);}}
  else if(h){arch=h;var btns=document.querySelectorAll('.f-btn');for(var i=0;i<btns.length;i++){btns[i].classList.toggle('on',btns[i].dataset.k===h);}}apply();}
if(window.OMNILORE_INDEX){boot(window.OMNILORE_INDEX);}else{fetch('assets/search-index.json').then(function(r){return r.json()}).then(boot);}
document.getElementById('bq').oninput=function(){q=this.value.trim();apply();};
document.getElementById('more').onclick=more;
var btns=document.querySelectorAll('.f-btn');
for(var i=0;i<btns.length;i++){btns[i].onclick=function(){arch=this.dataset.k;for(var j=0;j<btns.length;j++)btns[j].classList.remove('on');this.classList.add('on');apply();};}
var cbtns=document.querySelectorAll('.c-btn');
for(var i2=0;i2<cbtns.length;i2++){cbtns[i2].onclick=function(){cult=this.dataset.c;for(var j2=0;j2<cbtns.length;j2++)cbtns[j2].classList.remove('on');this.classList.add('on');apply();};}
})();
</script>
<aside id="content-advisory" role="dialog" aria-modal="true" aria-labelledby="advisory-title" hidden><div class="advisory-panel"><p class="advisory-kicker">Before you enter Omnilore</p><h1 id="advisory-title">Content advisory</h1><p>Omnilore is an archive of mythology, folklore, horror, religion, art, and internet-born fiction. Some entries or source images may include artistic or historical nudity, fictional gore, demons, violence, death, disturbing themes, or material some visitors may find offensive.</p><ul><li>Content is presented for research, context, cataloguing, and cultural reference.</li><li>Viewer discretion is advised; this archive is not intended for children.</li><li>By entering, you choose to encounter the material made available in the archive.</li></ul><div class="advisory-actions"><button class="advisory-enter" type="button">Enter the archive</button><button class="advisory-leave" type="button">Leave</button></div><a class="advisory-legal" href="legal.html#content-advisory">Read the full content advisory and terms →</a></div></aside><script>(function(){var key='omnilore-content-advisory-v1',gate=document.getElementById('content-advisory');if(!gate)return;try{if(localStorage.getItem(key)==='accepted')return;}catch(e){}gate.hidden=false;var enter=gate.querySelector('.advisory-enter'),leave=gate.querySelector('.advisory-leave');enter.onclick=function(){try{localStorage.setItem(key,'accepted')}catch(e){}gate.hidden=true};leave.onclick=function(){location.href='about:blank'};})();</script></body>
</html>